{
  "apphosting": [
    {
      "backendId": "art-auction",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions"
      ],
      "secrets": [
        "JWT_SECRET_KEY",
        "PAYSTACK_SECRET_KEY",
        "PROJECT_ID",
        "STORAGE_BUCKET"
      ],
      "alwaysDeployFromSource": true
    }
  ]
}
